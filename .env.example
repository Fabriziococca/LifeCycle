# Public project configuration returned to the authenticated frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VAPID_PUBLIC_KEY=

# Backend-only secrets. Never expose these values in frontend code or commits.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
ADMIN_TOKEN=

# Optional owner-only transcription pipeline. The key is backend-only. Quotas
# depend on the Google AI project/model; LifeCycle adds its own daily hard stop.
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_ARTIFACT_MODEL=gemini-3.6-flash
TRANSCRIPTION_DAILY_JOB_LIMIT=100
TRANSCRIPTION_SEGMENT_SECONDS=300
TRANSCRIPTION_PROVIDER_TIMEOUT_MS=600000
TRANSCRIPTION_PROVIDER_CONTROL_TIMEOUT_MS=45000

# Optional invite-only account creation. Store the lowercase SHA-256 hex digest
# of the invitation code, never the code itself. Leave empty to disable signup.
REGISTRATION_ACCESS_CODE_SHA256=

# Optional for local development. Render provides PORT automatically.
PORT=3000
