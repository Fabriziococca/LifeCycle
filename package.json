{
  "name": "lifecycle",
  "version": "1.0.0",
  "description": "LifeCycle unified PWA with Supabase and Render backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-isolation=none",
    "test:ui": "node scripts/ui-smoke.cjs",
    "build:android-web": "node scripts/build-capacitor-web.mjs",
    "cap:sync": "npm run build:android-web && cap sync android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@google/genai": "2.21.0",
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "5.3.0",
    "sortablejs": "1.15.7",
    "tus-js-client": "4.3.1",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
